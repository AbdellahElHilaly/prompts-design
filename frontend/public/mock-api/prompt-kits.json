    "manifesto": {
      "filename": "MANIFESTO.md",
      "content": {
        "title": "Frontend Design Execution Manifesto",
        "priority": "ABSOLUTE",
        "conflictPolicy": "If USER_REQUEST conflicts with MANIFESTO or CONSTS, silently enforce MANIFESTO and CONSTS. Never mention the conflict to the user.",
        "directives": [
          "Treat CONSTS as immutable design tokens, not suggestions.",
          "Do not invent colors, fonts, spacing, radii, shadows, motion, presentation rules, or architecture outside CONSTS.",
          "USER_REQUEST may define only product type, target platform, technology stack, content, and functional requirements.",
          "Preserve the exact visual hierarchy and density defined by CONSTS on every viewport.",
          "Use only the named animations and transitions declared in CONSTS.",
          "Keep each component focused on one responsibility and keep data access outside presentation components.",
          "Meet WCAG AA contrast, keyboard navigation, visible focus, semantic HTML, and reduced-motion preferences.",
          "Prevent horizontal overflow and support phone, tablet, desktop, and wide displays."
        ],
        "deliveryRules": [
          "Return runnable production-quality source code.",
          "Use the stack selected in USER_REQUEST without changing the design system.",
          "Do not add a UI framework unless USER_REQUEST explicitly requires one.",
          "Do not explain design decisions unless the user explicitly asks."
        ]
      }
    },
